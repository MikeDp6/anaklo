# Copy to .env.local (never commit it). Values below are the LOCAL Supabase stack defaults
# printed by `npm run db:start` / `npm run db:status`; they are public by design.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# The /api proxy (Vite dev middleware locally, the Cloudflare Worker when deployed, ADR-0008).
# Not VITE_: these never reach the browser. PROXY_SECRET must match the Edge Functions' secret
# (locally via [edge_runtime.secrets] in supabase/config.toml, which the Supabase CLI resolves
# from this file: restart the stack after changing it). At least 16 characters. APP_ENV=local
# relaxes only the trusted-device cookie (no __Host-/Secure on http://localhost).
PROXY_SECRET=local-dev-proxy-secret-change-me
APP_ENV=local

# Edge Functions public-booking / manage (step 1.3, contract §7). LOCAL values, not secrets;
# the local edge runtime reads them through [edge_runtime.secrets] in supabase/config.toml
# (restart the stack after a change). ANAKLO_ENV unset or unknown = prod, which refuses the fake
# SMS adapter, the test numbers and SMS_ALLOWED_RECIPIENTS (500 not_configured).
# SITE_HOST: the host of the SMS links, without a scheme, at most 15 characters.
# OTP_TEST_NUMBERS get OTP_TEST_CODE instead of a random code (seed clients +306900000001/2 and
# +306900000999, a number without a client). The fake adapter sends nothing; with
# ANAKLO_ENV=local it prints every SMS text (number masked) in the function logs.
# SMS_ALLOWED_RECIPIENTS: comma list of E.164; empty = no filter.
ANAKLO_ENV=local
SITE_HOST=localhost:5173
SMS_PROVIDER=fake
OTP_TEST_NUMBERS=+306900000001,+306900000002,+306900000999
OTP_TEST_CODE=424242
SMS_ALLOWED_RECIPIENTS=

# Messaging (step 1.5, contract §3.5). LOCAL values, not secrets; the edge runtime reads them
# through [edge_runtime.secrets] (restart the stack after a change). Without them public-booking,
# manage and dispatch answer 500 not_configured.
# PUSH_PROVIDER=fake builds the exact OneSignal payload and sends nothing (the row ends `sent`
# with provider `fake`; with ANAKLO_ENV=local one log line per push). fake is refused in prod.
# DISPATCH_SECRET: the header pg_net sends to dispatch. Must equal the seed's Vault value
# (supabase/seed.sql), ≥ 32 characters; this public value is refused in prod.
PUSH_PROVIDER=fake
DISPATCH_SECRET=local-dev-only-dispatch-secret-not-a-secret-01

# Staff push (ADR-0010): the pro app's Settings → Notifications. Public app id; leave empty
# (locally until 1.10): the screen says notifications are not available yet.
# A OneSignal app is bound to one origin: this is the LOCAL one (deploy:dev never uses it).
VITE_ONESIGNAL_APP_ID=

# Nous support contact on the pro app's «Χάσατε τη συσκευή σας;» screen (step 1.7, contract D19).
# Public (shown on screen). SYNTHETIC placeholders until the real ones are decided; the deploy
# environment gets the real values at 1.10. Phone in E.164. Empty or malformed hides that link.
VITE_SUPPORT_EMAIL=support@example.com
VITE_SUPPORT_PHONE=+302100000000

# Remote projects (used by `npm run db:push` / `db:reset:dev`, never by the frontend build).
# The dev project ref is the only one db:reset:dev, deploy:dev, secrets:dev and provision:dev
# will ever touch.
SUPABASE_DEV_PROJECT_REF=
# Public: the dev project's sb_publishable_ key. deploy:dev builds the dev bundle with it and
# secrets:dev sets it as the Worker secret SUPABASE_PUBLISHABLE_KEY.
SUPABASE_DEV_PUBLISHABLE_KEY=

# NEVER in this file or in .env.local: SUPABASE_SECRET_KEY (provision:dev), SUPABASE_ACCESS_TOKEN,
# SUPABASE_DB_PASSWORD, CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, the remote PROXY_SECRET,
# ONESIGNAL_APP_ID / ONESIGNAL_REST_API_KEY, OTP_HMAC_KEY / PHONE_HMAC_KEY (Vault). They live in a
# file OUTSIDE the repo, passed with `--env-file` (docs/SETUP.md §3).
