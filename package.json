{
  "name": "anaklo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "node scripts/check-secrets.mjs",
    "preview": "vite preview",
    "edge:dev": "wrangler dev --config edge/wrangler.jsonc",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json && tsc -p tsconfig.edge.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:race": "vitest run --config vitest.db.config.ts",
    "e2e": "playwright test",
    "size": "node scripts/check-size.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:dev": "supabase test db --linked",
    "db:push": "supabase db push",
    "db:reset:dev": "node scripts/db-reset-dev.mjs",
    "fn:check": "node scripts/fn-check.mjs",
    "fn:serve": "supabase functions serve --env-file .env.local",
    "fn:deploy:dev": "node scripts/fn-deploy-dev.mjs",
    "provision:dev": "node scripts/provision-business.mjs",
    "provision:local": "node scripts/provision-business.mjs --local",
    "deploy:dev": "node scripts/deploy-dev.mjs",
    "secrets:dev": "node scripts/secrets-dev.mjs",
    "gen:types": "node scripts/gen-types.mjs",
    "gen:icons": "node scripts/gen-icons.mjs",
    "prepare": "husky",
    "check:types": "node scripts/gen-types.mjs --check"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/gfs-didot": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "@tanstack/react-query": "5.104.0",
    "date-fns": "4.4.0",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "17.0.15",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260927.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "deno": "2.9.6",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "husky": "9.1.7",
    "jsdom": "30.1.1",
    "lint-staged": "17.6.0",
    "prettier": "3.9.9",
    "supabase": "2.118.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "wrangler": "4.142.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,html,yml,yaml}": "prettier --write"
  }
}
